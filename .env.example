# API
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database:
# - Default local mode uses embedded PGlite (no Docker required):
DATABASE_URL=pglite
# - Or use Docker Postgres from docker-compose.yml:
# DATABASE_URL=postgres://email_agent:email_agent@localhost:5433/email_task_agent
USE_PGLITE=true

# Demo auth — any email signs in as that user in the prototype
DEMO_AUTH_ENABLED=true

# Gmail OAuth (create at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/gmail/callback

# Microsoft Graph OAuth (optional / second provider)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/oauth/microsoft/callback

# IMAP works for any provider without OAuth (app password recommended).
# No extra env vars required for IMAP.

# LLM extraction — prefer Gemini (no OpenAI key required).
# Leave both empty to use the deterministic fallback parser only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional OpenAI-compatible fallback:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Fixture provider — connect a fake mailbox that scans bundled fixture emails
ENABLE_FIXTURE_PROVIDER=true

# Frontend (Vite) — set in Vercel project settings for production builds.
# Leave unset locally so the Vite `/api` proxy is used.
# VITE_API_BASE_URL=https://your-api-host.example.com

# Entity catalog used for fuzzy county/entity mapping
ENTITY_CATALOG_PATH=./apps/api/data/entities.json
